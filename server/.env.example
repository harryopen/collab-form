PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS / CSRF / socket handshake)
CLIENT_ORIGINS=http://localhost:5173
# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://collabdocs:collabdocs@localhost:5432/collabdocs
# Secret for signing session JWTs (>= 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
# Google login (optional). Create a Web OAuth client in Google Cloud Console with this
# exact redirect URI (use localhost, not 127.0.0.1). Set all three or none.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
